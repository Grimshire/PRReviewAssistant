-import { expect, test } from '@playwright/test';
+import { expect, test } from './helpers/test';
 import { expectBypassUserIdentity } from './helpers/auth';
 import { waitForSchedulerReady } from './helpers/scheduler';
 
 /**
  * Bypass-identity smoke until OIDC UI login exists.
  *
  * Under AUTH_BYPASS_ENABLED the API auto-authenticates, so these tests prove
  * the scheduler happy path for the bypass user and that hard API 401s still
  * kick the browser to /loggedoff — not that IdP login or role gates work.
  */
 test.describe('Scheduler access', () => {
     test(
         'bypass identity can open the scheduler',
         { tag: '@smoke' },
         async ({ page }) => {
             await expectBypassUserIdentity(page);
 
             await page.goto('/slate');
             await expect(page).toHaveURL(/\/slate\/?$/);
             await expect(page).not.toHaveURL(/\/loggedoff|\/unauthorized/);
 
             const header = page.getByRole('banner');
             await expect(header).toBeVisible();
             await expect(header).toContainText('SOCEUR J6');
 
             await waitForSchedulerReady(page);
             await expect(
                 page.getByRole('button', { name: 'Zoom out' })
             ).toBeVisible();
             await expect(page.getByText('1 Month')).toBeVisible();
             await expect(page.getByText('Loading calendar…')).toHaveCount(0);
         }
     );
 
     test(
         'API 401 while loading the scheduler sends the user to logged off',
         { tag: '@smoke' },
         async ({ page }) => {
             await page.route('**/api/**', async (route) => {
                 await route.fulfill({
                     status: 401,
                     contentType: 'application/json',
                     body: JSON.stringify({ message: 'Unauthorized' })
                 });
             });
 
             await page.goto('/slate');
             await expect(page).toHaveURL(/\/loggedoff\/?$/, { timeout: 30_000 });
             await expect(
                 page.getByRole('button', { name: 'Zoom out' })
             ).toHaveCount(0);
         }
     );
 });
