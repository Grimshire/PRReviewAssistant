+
+    import app.db.session as db_session
+
+    monkeypatch.setattr(db_session, "AsyncSessionLocal", lambda: _Session())
+
+    seen: list[bool] = []
+
+    class _Provider:
+        async def get_events(self, args):
+            seen.append(args.force_refresh)
+            return [
+                EventDetail(id=str(len(seen)), name="e", source_name=args.source_name)
+            ]
+
+    monkeypatch.setattr(svc, "_provider_for_type", lambda *a, **k: _Provider())
+    start, end = datetime(2026, 6, 1, tzinfo=UTC), datetime(2026, 6, 30, tzinfo=UTC)
+
+    first = await svc._fetch_source(source_id, start, end)
+    cached = await svc._fetch_source(source_id, start, end)
+    forced = await svc._fetch_source(source_id, start, end, force_refresh=True)
+    after = await svc._fetch_source(source_id, start, end)
+
+    assert seen == [False, True]
+    assert cached[0].id == first[0].id == "1"
+    assert forced[0].id == after[0].id == "2"
+
+    _, expires_at = event_cache._store[event_cache._key(str(source_id), start, end)]
+    assert (expires_at - datetime.now(UTC)).total_seconds() > 500
