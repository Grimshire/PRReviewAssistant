+"""Unit tests for provider-level cache lifetimes and user-requested refresh."""
+
+import asyncio
+from datetime import UTC, datetime, timedelta
+
+import httpx
+import pytest
+
+from app.providers import cache as event_cache
+from app.providers import sp_api_proxy
+from app.providers.base import EventDetail, EventDetailArgs
+from app.providers.sharepoint import SharePointProvider
+
+PROXY_URL = "http://localhost:3033/sp-api"
+
+ROWS = [
+    {"Title": "June", "EventDate": "2026-06-10T09:00:00Z"},
+    {"Title": "July", "EventDate": "2026-07-10T09:00:00Z"},
+]
+
+
+@pytest.fixture
+def proxy(monkeypatch):
+    monkeypatch.setattr(sp_api_proxy.settings, "sp_api_proxy_url", PROXY_URL)
+    monkeypatch.setattr(sp_api_proxy.settings, "event_detail_cache_enabled", True)
+    sp_api_proxy.clear_list_cache()
+    state = {"calls": 0}
+
+    async def handler(request: httpx.Request) -> httpx.Response:
+        state["calls"] += 1
+        await asyncio.sleep(0)
+        return httpx.Response(200, json={"value": ROWS})
+
+    real_client = httpx.AsyncClient
+    monkeypatch.setattr(
+        sp_api_proxy.httpx,
+        "AsyncClient",
+        lambda **kw: real_client(transport=httpx.MockTransport(handler), **kw),
+    )
+    yield state
+    sp_api_proxy.clear_list_cache()
+
+
+def _args(month: int, *, force: bool = False, ttl: object = "300") -> EventDetailArgs:
+    return EventDetailArgs(
+        resource_id="res-1",
+        source_name="SP Events",
+        start=datetime(2026, month, 1, tzinfo=UTC),
+        end=datetime(2026, month, 28, tzinfo=UTC),
+        provider_properties={"url": PROXY_URL, "cacheExpireSeconds": ttl},
+        source_properties={"url": "Team Events"},
+        force_refresh=force,
+    )
+
+
+# ── Provider cache lifetime ────────────────────────────────────────────────────
+
+
+def test_ttl_seconds_uses_provider_setting_with_global_fallback(monkeypatch):
+    monkeypatch.setattr(event_cache.settings, "event_detail_cache_seconds", 30)
+    assert event_cache.ttl_seconds({"cacheExpireSeconds": "600"}) == 600
+    assert event_cache.ttl_seconds({"cacheExpireSeconds": 900}) == 900
+    assert event_cache.ttl_seconds({"cacheExpireSeconds": ""}) == 30
+    assert event_cache.ttl_seconds({"cacheExpireSeconds": "abc"}) == 30
+    assert event_cache.ttl_seconds({"cacheExpireSeconds": 0}) == 30
+    assert event_cache.ttl_seconds({}) == 30
+    assert event_cache.ttl_seconds(None) == 30
+
+
+def test_cache_put_honours_explicit_ttl(monkeypatch):
+    monkeypatch.setattr(event_cache.settings, "event_detail_cache_enabled", True)
+    monkeypatch.setattr(event_cache.settings, "event_detail_cache_seconds", 30)
+    event_cache.clear()
+    start, end = datetime(2026, 1, 1, tzinfo=UTC), datetime(2026, 1, 31, tzinfo=UTC)
+
+    event_cache.put(
+        "res-ttl", start, end, [EventDetail(id="1", name="x", source_name="s")], ttl=600
+    )
+
+    _, expires_at = event_cache._store[event_cache._key("res-ttl", start, end)]
+    remaining = (expires_at - datetime.now(UTC)).total_seconds()
+    assert 590 < remaining <= 600
+    event_cache.clear()
+
+
+# ── Whole-list cache behind the SharePoint proxy ───────────────────────────────
+
+
+async def test_list_is_downloaded_once_across_date_windows(proxy):
+    prov = SharePointProvider()
+
+    june = await prov.get_events(_args(6))
+    july = await prov.get_events(_args(7))
+
+    assert [e.name for e in june] == ["June"]
+    assert [e.name for e in july] == ["July"]
+    assert proxy["calls"] == 1
+
+
