+
+
+async def test_fetch_source_force_refresh_bypasses_event_cache(monkeypatch):
+    import uuid
+    from types import SimpleNamespace
+
+    from app.services import event_details as svc
+
+    monkeypatch.setattr(event_cache.settings, "event_detail_cache_enabled", True)
+    event_cache.clear()
+    source_id = uuid.uuid4()
+    row = (
+        SimpleNamespace(name="Src", properties={}),
+        SimpleNamespace(properties={"cacheExpireSeconds": "600"}),
+        SimpleNamespace(name="SharePoint"),
+    )
+
+    class _Session:
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *exc):
