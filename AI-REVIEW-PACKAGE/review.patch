+from app.providers.base import EventDetailArgs
+from app.providers.sharepoint import SharePointProvider
+
+PROXY_URL = "http://localhost:3033/sp-api"
+
+LIST_PAYLOAD = {
+    "odata.metadata": "https://sp.local/_api/$metadata#SP.ListData.EventsListItems",
+    "value": [
+        {
+            "odata.type": "SP.Data.EventsListItem",
+            "Id": 1,
+            "Title": "Staff Sync",
+            "EventDate": "2026-06-10T09:00:00Z",
+            "EndDate": "2026-06-10T10:00:00Z",
+            "Category": "Meeting",
+        },
+        {
+            "Id": 2,
+            "Title": "Long Exercise",
+            "EventDate": "2026-05-20T00:00:00Z",
+            "EndDate": "2026-06-05T00:00:00Z",
+            "Category": "Training",
+            "fAllDayEvent": True,
+        },
+        {
+            "Id": 3,
+            "Title": "Old Event",
+            "EventDate": "2025-01-01T09:00:00Z",
+            "EndDate": "2025-01-01T10:00:00Z",
+            "Category": "Meeting",
+        },
+        {"Id": 4, "Title": "No Dates", "Category": "Meeting"},
+    ],
+}
+
+
+@pytest.fixture
+def proxy(monkeypatch):
+    """Point settings at the proxy and serve requests from a mock transport."""
+    monkeypatch.setattr(sp_api_proxy.settings, "sp_api_proxy_url", PROXY_URL)
+    sp_api_proxy.clear_list_cache()
+    state: dict = {"requests": [], "status": 200, "payload": LIST_PAYLOAD}
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        state["requests"].append(request)
+        if request.url.path.endswith("/health"):
+            return httpx.Response(state["status"], json={"status": "ok"})
+        return httpx.Response(state["status"], json=state["payload"])
+
+    real_client = httpx.AsyncClient
+    monkeypatch.setattr(
+        sp_api_proxy.httpx,
+        "AsyncClient",
+        lambda **kw: real_client(transport=httpx.MockTransport(handler), **kw),
+    )
+    return state
+
+
+def _args(**source_props) -> EventDetailArgs:
+    return EventDetailArgs(
+        resource_id="res-1",
+        source_name="SP Events",
+        start=datetime(2026, 6, 1, tzinfo=UTC),
+        end=datetime(2026, 6, 30, tzinfo=UTC),
+        provider_properties={"url": PROXY_URL + "/"},
+        source_properties={"url": "Team Events", **source_props},
+    )
+
+
+def test_is_proxy_url_matches_configured_url_only(monkeypatch):
+    monkeypatch.setattr(sp_api_proxy.settings, "sp_api_proxy_url", PROXY_URL)
+    assert sp_api_proxy.is_proxy_url("HTTP://localhost:3033/sp-api/")
+    assert not sp_api_proxy.is_proxy_url("https://sp.local/sites/team")
+
+    monkeypatch.setattr(sp_api_proxy.settings, "sp_api_proxy_url", "")
+    assert not sp_api_proxy.is_proxy_url("")
+    assert not sp_api_proxy.is_proxy_url(PROXY_URL)
+
+
+def test_extract_items_handles_all_payload_shapes():
+    rows = [{"Id": 1}]
+    assert sp_api_proxy.extract_items({"value": rows}) == rows
+    assert sp_api_proxy.extract_items({"d": {"results": rows}}) == rows
+    assert sp_api_proxy.extract_items(rows) == rows
+    assert sp_api_proxy.extract_items({"error": "nope"}) == []
+    assert sp_api_proxy.extract_items(None) == []
+
+
+async def test_get_events_returns_only_events_overlapping_window(proxy):
+    events = await SharePointProvider().get_events(_args())
+
+    assert sorted(e.name for e in events) == ["Long Exercise", "Staff Sync"]
+    sync = next(e for e in events if e.name == "Staff Sync")
+    assert sync.start_dtime == datetime(2026, 6, 10, 9, tzinfo=UTC)
+    assert sync.end_dtime == datetime(2026, 6, 10, 10, tzinfo=UTC)
+    assert sync.source_name == "SP Events"
+    assert sync.resource_id == "res-1"
+    assert sync.properties["Category"] == "Meeting"
+    assert next(e for e in events if e.name == "Long Exercise").is_all_day
+
+
+async def test_get_events_requests_list_by_encoded_title(proxy):
+    await SharePointProvider().get_events(_args())
+
+    assert len(proxy["requests"]) == 1
+    assert proxy["requests"][0].url.raw_path == b"/sp-api/list-items/Team%20Events"
+
+
+async def test_get_events_honours_custom_fields_and_source_filter(proxy):
+    proxy["payload"] = {
+        "value": [
+            {"Subject": "A", "Begin": "2026-06-02T08:00:00Z", "Kind": "Keep"},
+            {"Subject": "B", "Begin": "2026-06-03T08:00:00Z", "Kind": "Drop"},
+        ]
+    }
+    events = await SharePointProvider().get_events(
+        _args(
+            titleFieldName="Subject",
+            startDtimeFieldName="Begin",
+            endDtimeFieldName="Finish",
+            filter='{"field": "Kind", "operator": "eq", "value": "Keep"}',
+        )
+    )
+
+    assert [e.name for e in events] == ["A"]
+    assert events[0].end_dtime is None
+
+
+async def test_get_events_raises_sharepoint_exception_on_proxy_error(proxy):
+    proxy["status"] = 500
+    with pytest.raises(SharePointException):
+        await SharePointProvider().get_events(_args())
+
+
+async def test_source_fields_and_test_source_via_proxy(proxy):
+    prov = SharePointProvider()
+    pp, sp = {"url": PROXY_URL}, {"url": "Team Events"}
+
+    fields = await prov.get_source_fields(pp, sp)
+    assert fields == ["Id", "Title", "EventDate", "EndDate", "Category", "fAllDayEvent"]
+
+    result = await prov.test_source(pp, sp)
+    assert result["success"] is True
+
+    proxy["status"] = 500
+    assert await prov.get_source_fields(pp, sp) == []
+
+
+async def test_get_status_uses_proxy_health(proxy):
+    prov = SharePointProvider()
+    assert await prov.get_status({"url": PROXY_URL}) == "ok"
+    assert proxy["requests"][-1].url.path == "/sp-api/health"
+
+    proxy["status"] = 503
+    assert await prov.get_status({"url": PROXY_URL}) == "degraded"
