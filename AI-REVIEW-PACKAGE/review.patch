+import { test as base, expect } from '@playwright/test';
+
+/**
+ * Test fixture that acknowledges the DoD warning before each page loads.
+ *
+ * The warning dialog is modal (Radix), so while it is open the rest of the app
+ * is hidden from accessibility queries (getByRole('banner'), etc.).
+ * Use this `test` instead of importing from '@playwright/test' in specs.
+ */
+export const test = base.extend({
+    page: async ({ page }, use) => {
+        await page.addInitScript(() => {
+            try {
+                window.sessionStorage.setItem('dod-warning-acknowledged', 'true');
+            } catch {
+                /* storage unavailable: dialog will show */
+            }
+        });
+        await use(page);
+    }
+});
+
+export { expect };
