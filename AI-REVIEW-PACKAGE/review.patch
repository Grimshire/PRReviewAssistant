-        seconds=settings.event_detail_cache_seconds
+        seconds=ttl if ttl is not None else settings.event_detail_cache_seconds
     )
     _store[k] = (events, expires_at)
     _store.move_to_end(k)
 
     max_entries = settings.event_detail_cache_max_entries
     while len(_store) > max_entries:
         _store.popitem(last=False)
 
 
 def sweep() -> int:
     """Remove all expired entries. Returns the number of entries evicted.
 
     Runs on a periodic schedule so date-range windows that are never
     re-read (e.g. past dates) don't linger in memory until process restart.
     """
     now = datetime.now(UTC)
     expired_keys = [k for k, (_, expires_at) in _store.items() if now > expires_at]
     for k in expired_keys:
         del _store[k]
     return len(expired_keys)
 
 
 def clear() -> None:
     _store.clear()
