+    key = next(iter(sp_api_proxy._list_cache))
+    rows, _ = sp_api_proxy._list_cache[key]
+    sp_api_proxy._list_cache[key] = (rows, datetime.now(UTC) - timedelta(seconds=1))
+
+    await prov.get_events(_args(6))
