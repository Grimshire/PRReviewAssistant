+    await sp_api_proxy.fetch_list_items(PROXY_URL, "Stale", ttl_seconds=300)
+    stale_key = next(k for k in sp_api_proxy._list_cache if k.endswith("|Stale"))
+    rows, _ = sp_api_proxy._list_cache[stale_key]
+    sp_api_proxy._list_cache[stale_key] = (
+        rows,
+        datetime.now(UTC) - timedelta(seconds=1),
+    )
+
+    assert sp_api_proxy.sweep_lists() == 1
+    assert list(sp_api_proxy._list_cache) == [f"{PROXY_URL}|Live"]
