+"""
+Client for sp-api-proxy — the Node service that reads SharePoint lists with an
+NTLM service account on SLATE's behalf.
+
+The proxy is bound to a single SharePoint site (its SP_SITE_URL) and exposes:
+
+    GET {root}/list-items/{listTitle}   → raw SharePoint REST payload
+    GET {root}/health                   → {"status": "ok"}
+
+It takes no query options, so date-range and field filtering happen here, and
+whole lists are cached in-process so calendar navigation does not re-download
+them.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections import OrderedDict
+from datetime import UTC, datetime, timedelta
+from urllib.parse import quote
+
+import httpx
+
+from app.core.config import settings
+from app.providers.utils import parse_event_date
+
+# OData bookkeeping keys that are not list columns.
+_METADATA_PREFIXES = ("odata.", "@odata.", "__")
+
+
+def _normalize(url: str) -> str:
+    return url.strip().rstrip("/").lower()
+
+
+def is_proxy_url(provider_url: str) -> bool:
+    """True when a provider's URL points at the configured sp-api-proxy."""
+    proxy_url = _normalize(settings.sp_api_proxy_url)
+    return bool(proxy_url) and _normalize(provider_url) == proxy_url
+
+
+def extract_items(payload: object) -> list[dict]:
+    """Pull list rows out of a SharePoint REST payload.
+
+    Handles the default shape ({"value": [...]}), odata=verbose
+    ({"d": {"results": [...]}}), and a bare array.
+    """
+    rows: object = payload
+    if isinstance(payload, dict):
+        if isinstance(payload.get("value"), list):
+            rows = payload["value"]
+        elif isinstance(payload.get("d"), dict):
+            rows = payload["d"].get("results", [])
+        else:
+            rows = []
+    if not isinstance(rows, list):
+        return []
+    return [dict(row) for row in rows if isinstance(row, dict)]
+
+
+def field_names(items: list[dict]) -> list[str]:
+    """Column names seen across the rows, in first-seen order."""
+    names: dict[str, None] = {}
+    for item in items:
+        for key in item:
+            if not key.startswith(_METADATA_PREFIXES):
+                names.setdefault(key, None)
+    return list(names)
+
+
+def overlaps_window(
+    item: dict,
+    start_field: str,
+    end_field: str,
+    window_start: datetime,
+    window_end: datetime,
+) -> bool:
+    """True when the row's [start, end] range intersects the requested window.
+
+    Rows with no parseable start date are dropped; a missing end date is
+    treated as a point-in-time event at the start.
+    """
+    item_start = parse_event_date(item.get(start_field))
+    if item_start is None:
+        return False
+    item_end = parse_event_date(item.get(end_field)) or item_start
+    win_start = parse_event_date(window_start)
+    win_end = parse_event_date(window_end)
+    return item_start <= win_end and item_end >= win_start
+
+
+# ── Whole-list cache ───────────────────────────────────────────────────────────
+# The proxy always returns the entire list, so one cached copy serves every
+# date window the calendar asks for. key → (rows, expires_at)
+_LIST_CACHE_MAX_ENTRIES = 200
+_list_cache: OrderedDict[str, tuple[list[dict], datetime]] = OrderedDict()
+_list_locks: dict[str, asyncio.Lock] = {}
+
+
+def _cached_rows(key: str) -> list[dict] | None:
+    entry = _list_cache.get(key)
+    if entry is None:
+        return None
+    rows, expires_at = entry
+    if datetime.now(UTC) > expires_at:
+        del _list_cache[key]
+        return None
+    _list_cache.move_to_end(key)
+    return rows
+
+
+async def fetch_list_items(
+    proxy_url: str,
+    list_title: str,
+    *,
+    ttl_seconds: int = 0,
+    force_refresh: bool = False,
+) -> list[dict]:
+    """Return every row of a SharePoint list, via the proxy.
+
+    Rows are cached for `ttl_seconds` (0 disables caching). `force_refresh`
+    skips the cached copy and replaces it. Callers must not mutate the rows.
+    """
+    use_cache = settings.event_detail_cache_enabled and ttl_seconds > 0
+    key = f"{_normalize(proxy_url)}|{list_title}"
+
+    if use_cache and not force_refresh:
+        rows = _cached_rows(key)
+        if rows is not None:
+            return rows
+
+    # One fetch per list at a time: concurrent callers wait and share the result.
+    lock = _list_locks.setdefault(key, asyncio.Lock())
+    waited = lock.locked()
+    async with lock:
+        if use_cache and (waited or not force_refresh):
+            rows = _cached_rows(key)
+            if rows is not None:
+                return rows
+
+        endpoint = f"{proxy_url.rstrip('/')}/list-items/{quote(list_title, safe='')}"
+        async with httpx.AsyncClient() as client:
+            resp = await client.get(
+                endpoint,
+                headers={"Accept": "application/json"},
+                timeout=settings.sp_api_proxy_timeout_seconds,
+            )
+            resp.raise_for_status()
+            rows = extract_items(resp.json())
+
+        if use_cache:
+            _list_cache[key] = (
+                rows,
+                datetime.now(UTC) + timedelta(seconds=ttl_seconds),
+            )
+            _list_cache.move_to_end(key)
+            while len(_list_cache) > _LIST_CACHE_MAX_ENTRIES:
+                _list_cache.popitem(last=False)
+        return rows
+
+
+def sweep_lists() -> int:
+    """Remove expired cached lists. Returns the number of entries evicted."""
+    now = datetime.now(UTC)
+    expired = [k for k, (_, expires_at) in _list_cache.items() if now > expires_at]
+    for k in expired:
+        del _list_cache[k]
+        _list_locks.pop(k, None)
+    return len(expired)
+
+
+def clear_list_cache() -> None:
+    _list_cache.clear()
+    _list_locks.clear()
+
+
+async def is_healthy(proxy_url: str) -> bool:
+    async with httpx.AsyncClient() as client:
+        resp = await client.get(f"{proxy_url.rstrip('/')}/health", timeout=10)
+    return resp.is_success and resp.json().get("status") == "ok"
