+async def _user_from_header(username: str) -> CurrentUser:
+    """Find or create a user by their CAC username; assign User role on first login.
+
+    Uses a single commit for the happy path. If two requests race on a brand-new
+    user, the second INSERT raises IntegrityError; we roll back and re-fetch so
+    both requests succeed without error.
+    """
+    from sqlalchemy.exc import IntegrityError
+
+    from app.constants import SYSTEM_USER_ID
+    from app.core.dependencies import RoleNames
+    from app.db.session import AsyncSessionLocal
+    from app.models.role import Role
+    from app.models.user import User, UserRole
+
+    async with AsyncSessionLocal() as session:
+        now = datetime.now(UTC)
+
+        user = await _find_user_by_username(session, username)
+
+        if user is None:
+            try:
+                user = User(
+                    username=username,
+                    is_active=True,
+                    created_time=now,
+                    created_by=SYSTEM_USER_ID,
+                )
+                session.add(user)
+                await session.flush()  # populate user.id before referencing it
+
+                default_role = await session.scalar(
+                    select(Role).where(Role.name == RoleNames.USER)
+                )
+                if default_role is not None:
+                    session.add(
+                        UserRole(
+                            user_id=user.id,
+                            role_id=default_role.id,
+                            created_time=now,
+                            created_by=user.id,
+                            modified_time=now,
+                            modified_by=user.id,
+                        )
+                    )
+                    await session.flush()
+
+            except IntegrityError as exc:
+                # Concurrent request created this user between our SELECT and INSERT.
+                await session.rollback()
+                user = await _find_user_by_username(session, username)
+                if user is None:
+                    raise HTTPException(
+                        status_code=500, detail="Failed to resolve user"
+                    ) from exc
+
+        user.last_logged_in = now
+        user.modified_time = now
+        user.modified_by = user.id
+        await session.commit()
+        await session.refresh(user, ["roles"])
+
+        roles = [ur.role.name for ur in user.roles if ur.role]
+        current_user = CurrentUser(
+            sub=username,
+            user_id=str(user.id),
+            roles=roles,
+        )
+
+    current_user_id_var.set(str(user.id))
+    structlog.contextvars.bind_contextvars(user_sub=username)
+    return current_user
