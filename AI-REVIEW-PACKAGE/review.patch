 """
 In-process event detail cache with configurable TTL.
 
 Cache key: {resource_id}:{start_dtime_short}:{end_dtime_short}
 Only caches non-empty results.
 
 Bounded via two complementary mechanisms so a long-running worker never
 accumulates stale entries indefinitely:
 - Hard cap on put(): once event_detail_cache_max_entries is reached, the
   oldest entry (OrderedDict insertion/access order) is evicted first.
 - Active sweep(): scheduled periodically (see app/tasks/cache_sweep.py) to
   drop expired entries even if their key is never read again.
 """
 
 from __future__ import annotations
 
 from collections import OrderedDict
 from datetime import UTC, datetime, timedelta
 
 from app.core.config import settings
 from app.providers.base import EventDetail
 
 _store: OrderedDict[str, tuple[list[EventDetail], datetime]] = OrderedDict()
 
 
 def _key(resource_id: str, start: datetime, end: datetime) -> str:
     return f"{resource_id}:{start.strftime('%Y%m%d')}:{end.strftime('%Y%m%d')}"
 
 
 def get(resource_id: str, start: datetime, end: datetime) -> list[EventDetail] | None:
     if not settings.event_detail_cache_enabled:
         return None
     k = _key(resource_id, start, end)
     entry = _store.get(k)
     if entry is None:
         return None
     events, expires_at = entry
     if datetime.now(UTC) > expires_at:
         del _store[k]
         return None
     _store.move_to_end(k)
     return events
 
 
+def ttl_seconds(provider_properties: dict | None) -> int:
+    """Cache lifetime for a provider: its `cacheExpireSeconds` admin setting,
+    falling back to the global default when unset or invalid."""
+    raw = (provider_properties or {}).get("cacheExpireSeconds")
+    try:
+        ttl = int(raw)
+    except (TypeError, ValueError):
+        ttl = 0
+    return ttl if ttl > 0 else settings.event_detail_cache_seconds
+
