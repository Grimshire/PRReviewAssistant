 """EventDetails router — aggregates events from all configured providers."""
 
 from datetime import UTC, datetime
 
 from fastapi import APIRouter, Depends, HTTPException, Query
 
 from app.core.config import settings
 from app.core.dependencies import require_any_user
 from app.providers.base import EventDetail
 from app.services.event_details import get_event_details
 
 router = APIRouter(prefix="/api/eventdetails", tags=["event-details"])
 
 
 @router.get("", response_model=list[EventDetail])
 async def fetch_event_details(
     source_ids: list[str] = Query(default=[]),
     start: str | None = Query(default=None),
     end: str | None = Query(default=None),
+    # User-requested reload: skip cached events and re-query the providers.
+    refresh: bool = Query(default=False),
     _auth=Depends(require_any_user),
 ):
     if not source_ids:
         return []
 
     try:
         start_dt = (
             datetime.fromisoformat(start)
             if start
             else datetime.now(UTC).replace(hour=0, minute=0, second=0)
         )
         end_dt = (
             datetime.fromisoformat(end)
             if end
             else datetime.now(UTC).replace(hour=23, minute=59, second=59)
         )
     except ValueError as exc:
         raise HTTPException(
             status_code=400, detail=f"Invalid date format: {exc}"
         ) from exc
 
     return await get_event_details(
         source_ids,
         start_dt,
         end_dt,
         use_mock_providers=settings.should_use_mock_providers,
+        force_refresh=refresh,
     )
