 async def fetch_jwks() -> None:
     """Fetch and cache the JWKS from the OIDC authority's well-known endpoint.
 
     Called once at application startup via the lifespan context.
     Skipped gracefully when OIDC_AUTHORITY is not configured (local dev).
     """
     global _jwks_cache
 
     if not settings.oidc_authority:
         log.warning(
             "oidc_authority_not_set",
             msg="JWT validation disabled — set OIDC_AUTHORITY for production",
         )
         return
 
     url = settings.oidc_authority.rstrip("/") + "/.well-known/jwks"
     try:
         async with httpx.AsyncClient(verify=True, timeout=10) as client:
             resp = await client.get(url)
             resp.raise_for_status()
             _jwks_cache = resp.json()
             log.info("jwks_loaded", url=url, key_count=len(_jwks_cache.get("keys", [])))
     except Exception as exc:
         if settings.environment == "development":
             log.warning("jwks_fetch_skipped_for_development", url=url, error=str(exc))
             return
         log.error("jwks_fetch_failed", url=url, error=str(exc))
         raise
 
 
