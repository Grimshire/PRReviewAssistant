@@ -0,0 +1,55 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import * as eventDetailsApi from '@/services/eventDetailsApi';
+import { useSchedulerDataStore } from '@/stores/schedulerDataStore';
+import { useSchedulerPreferencesStore } from '@/stores/schedulerPreferencesStore';
+import { fireEvent, render, screen, waitFor } from '@/test/test-utils';
+import RefreshEventsButton from './RefreshEventsButton';
+
+vi.mock('@/services/eventDetailsApi');
+
+beforeEach(() => {
+    vi.clearAllMocks();
+    useSchedulerDataStore.setState({
+        visibleEventSourceIds: ['a'],
+        isLoadingEvents: false,
+        events: []
+    });
+    useSchedulerPreferencesStore.setState({ searchQuery: '' });
+    vi.mocked(eventDetailsApi.getEvents).mockResolvedValue([]);
+});
+
+describe('RefreshEventsButton', () => {
+    it('forces a server refresh for the range last fetched', async () => {
+        const range = {
+            start: new Date('2026-06-01T00:00:00Z'),
+            end: new Date('2026-06-30T23:59:59Z')
+        };
+        await useSchedulerDataStore.getState().refreshEvents(range);
+        expect(eventDetailsApi.getEvents).toHaveBeenLastCalledWith(
+            expect.not.objectContaining({ refresh: true })
+        );
+
+        render(<RefreshEventsButton />);
+        fireEvent.click(
+            screen.getByRole('button', { name: /refresh events/i })
+        );
+
+        await waitFor(() =>
+            expect(eventDetailsApi.getEvents).toHaveBeenCalledTimes(2)
+        );
+        expect(eventDetailsApi.getEvents).toHaveBeenLastCalledWith({
+            sourceIds: ['a'],
+            start: range.start.toISOString(),
+            end: range.end.toISOString(),
+            refresh: true
+        });
+    });
+
+    it('is disabled while events are loading', () => {
+        useSchedulerDataStore.setState({ isLoadingEvents: true });
+        render(<RefreshEventsButton />);
+        expect(
+            screen.getByRole('button', { name: /refresh events/i })
+        ).toBeDisabled();
+    });
+});
