+import { RefreshCw } from 'lucide-react';
+import { Button } from '@/components/ui/button';
+import { useSchedulerDataStore } from '@/stores/schedulerDataStore';
+
+/**
+ * Events are cached on the server per provider, so normal navigation does not
+ * re-query SharePoint, Outlook, etc. This button lets a user pull fresh data
+ * on demand.
+ */
+export default function RefreshEventsButton() {
+    const isLoadingEvents = useSchedulerDataStore((s) => s.isLoadingEvents);
+    const forceRefreshEvents = useSchedulerDataStore(
+        (s) => s.forceRefreshEvents
+    );
+
+    return (
+        <Button
+            variant="ghost"
+            size="icon"
+            className="h-8 w-8 text-muted-foreground hover:text-foreground"
+            onClick={() => void forceRefreshEvents()}
+            disabled={isLoadingEvents}
+            aria-label="Refresh events"
+            title="Refresh events from all sources"
+        >
+            <RefreshCw
+                className={`h-4 w-4 ${isLoadingEvents ? 'animate-spin' : ''}`}
+            />
+        </Button>
+    );
+}
